<Window x:Class="CrosshairOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CrosshairOverlay.Controls"
        xmlns:models="clr-namespace:CrosshairOverlay.Models"
        Title="Crosshair Overlay Settings"
        Height="720" Width="820"
        MinHeight="650" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Dark Theme Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0F1115" />
        <SolidColorBrush x:Key="CardBg" Color="#181B20" />
        <SolidColorBrush x:Key="CardBorder" Color="#2A2E38" />
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF66" />
        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF" />
        <SolidColorBrush x:Key="TextMuted" Color="#8B949E" />
        <SolidColorBrush x:Key="TextLight" Color="#F1F5F9" />

        <!-- Custom Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#00F0FF" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Setting Label Style -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextLight}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#00FF66" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Width" Value="45" />
        </Style>

        <!-- Color Palette Button Style -->
        <Style x:Key="ColorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#3A404D" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Action Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                        Background="#202530" BorderBrush="#363E4E" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="#8B949E" Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00F0FF" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#00F0FF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00FF66" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#00FF66" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="#14171E" CornerRadius="4" Margin="2,1" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252D3D" />
                                <Setter Property="Foreground" Value="#00FF66" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E2A3A" />
                                <Setter Property="Foreground" Value="#00F0FF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#14171E"
                                            BorderBrush="#363E4E"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="46" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Bottom Action Bar -->
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#14171D" BorderBrush="#252A34" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="5" Background="#00FF66" Margin="0,0,10,0">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#0F1115"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock Text="CROSSHAIR OVERLAY" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#1C2F24" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                        <TextBlock x:Name="TxtStatus" Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons (Min / Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                            Foreground="#8B949E" FontSize="14" Cursor="Hand" ToolTip="Minimize to Taskbar">
                        <TextBlock Text="—" Margin="0,-4,0,0"/>
                    </Button>
                    <Button x:Name="BtnHideToTray" Click="BtnHideToTray_Click" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                            Foreground="#8B949E" FontSize="14" Cursor="Hand" ToolTip="Hide Window (Keep Crosshair Active)">
                        <TextBlock Text="▼" Margin="0,0,0,0" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Width="36" Height="32" Background="Transparent" BorderThickness="0"
                            Foreground="#8B949E" FontSize="14" Cursor="Hand" ToolTip="Close Application">
                        <TextBlock Text="✕" Margin="0,0,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: 2 Columns (Preview & Quick Controls | Detailed Sliders) -->
        <Grid Grid.Row="1" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Live Preview, Style Selector, Color Picker -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Live Preview Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="LIVE PREVIEW" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="Center Reticle" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="180" CornerRadius="6" Background="#08090C" BorderBrush="#252A34" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <!-- Subtle Grid Pattern in background of preview -->
                                    <Path Stroke="#1A1F29" StrokeThickness="1">
                                        <Path.Data>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="0,90" EndPoint="300,90" />
                                                <LineGeometry StartPoint="150,0" EndPoint="150,180" />
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <!-- Center Preview Renderer -->
                                    <controls:CrosshairRenderer x:Name="PreviewRenderer" IsPreview="True" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Shape / Style Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="CROSSHAIR STYLE" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="CmbStyle" Height="34" SelectionChanged="CmbStyle_SelectionChanged">
                                <ComboBoxItem Content="✚   Classic Cross (+)" />
                                <ComboBoxItem Content="•    Center Dot (•)" />
                                <ComboBoxItem Content="✛   Cross + Dot (+•)" IsSelected="True" />
                                <ComboBoxItem Content="⊥   T-Shape (⊥)" />
                                <ComboBoxItem Content="◯   Circle (O)" />
                                <ComboBoxItem Content="⦿   Circle + Dot (⊙)" />
                                <ComboBoxItem Content="▲   Chevron (^)" />
                                <ComboBoxItem Content="▢   Box (□)" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Color Selection Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="COLOR &amp; PRESETS" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource ColorButtonStyle}" Background="#00FF66" Click="PresetColor_Click" Tag="#00FF66" ToolTip="Neon Green"/>
                                <Button Style="{StaticResource ColorButtonStyle}" Background="#00F0FF" Click="PresetColor_Click" Tag="#00F0FF" ToolTip="Cyan"/>
                                <Button Style="{StaticResource ColorButtonStyle}" Background="#FF3344" Click="PresetColor_Click" Tag="#FF3344" ToolTip="Crimson Red"/>
                                <Button Style="{StaticResource ColorButtonStyle}" Background="#FFE600" Click="PresetColor_Click" Tag="#FFE600" ToolTip="Electric Yellow"/>
                                <Button Style="{StaticResource ColorButtonStyle}" Background="#FFFFFF" Click="PresetColor_Click" Tag="#FFFFFF" ToolTip="Pure White"/>
                                <Button Style="{StaticResource ColorButtonStyle}" Background="#BF5AF2" Click="PresetColor_Click" Tag="#BF5AF2" ToolTip="Neon Purple"/>
                                <Button Style="{StaticResource ColorButtonStyle}" Background="#FF9500" Click="PresetColor_Click" Tag="#FF9500" ToolTip="Bright Orange"/>
                            </WrapPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hex Code:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtColorHex" Grid.Column="1" Height="28" Background="#222731" Foreground="#FFFFFF" BorderBrush="#353D4D"
                                         VerticalContentAlignment="Center" Padding="6,0" TextChanged="TxtColorHex_TextChanged" FontSize="12"/>
                                <Border x:Name="ColorPreviewSwatch" Grid.Column="2" Width="28" Height="28" CornerRadius="4" Background="#00FF66" Margin="8,0,0,0" BorderBrush="#444" BorderThickness="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Detailed Sliders (Geometry, Outline, Calibration, Hotkeys) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Geometry Dimensions Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="SIZE &amp; GEOMETRY" Style="{StaticResource SectionTitle}"/>

                            <!-- Arm Size (Length) -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Length / Radius (px)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderSize" Grid.Column="1" Minimum="2" Maximum="50" Value="10" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblSize" Grid.Column="2" Text="{Binding Value, ElementName=SliderSize, StringFormat={}{0:0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <!-- Thickness -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Thickness (px)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderThickness" Grid.Column="1" Minimum="1" Maximum="12" Value="2" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblThickness" Grid.Column="2" Text="{Binding Value, ElementName=SliderThickness, StringFormat={}{0:0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <!-- Center Gap -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Center Gap (px)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderGap" Grid.Column="1" Minimum="0" Maximum="30" Value="5" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblGap" Grid.Column="2" Text="{Binding Value, ElementName=SliderGap, StringFormat={}{0:0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <!-- Dot Size -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Center Dot Size (px)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderDotSize" Grid.Column="1" Minimum="1" Maximum="16" Value="3" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblDotSize" Grid.Column="2" Text="{Binding Value, ElementName=SliderDotSize, StringFormat={}{0:0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <!-- Opacity -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity (%)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderOpacity" Grid.Column="1" Minimum="10" Maximum="100" Value="100" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblOpacity" Grid.Column="2" Text="{Binding Value, ElementName=SliderOpacity, StringFormat={}{0:0}%}" Style="{StaticResource ValueLabel}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Outline / Border Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="OUTLINE / CONTRAST BORDER" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <CheckBox x:Name="ChkHasOutline" Content="Enable Outline" Foreground="{StaticResource TextLight}"
                                          IsChecked="True" HorizontalAlignment="Right" Checked="ChkHasOutline_Changed" Unchecked="ChkHasOutline_Changed"/>
                            </Grid>
                            <TextBlock Text="Menambahkan border kontras agar bidikan tetap terlihat di map terang atau gelap."
                                       FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Outline Thickness (px)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderOutlineThickness" Grid.Column="1" Minimum="0.5" Maximum="4" Value="1" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblOutlineThickness" Grid.Column="2" Text="{Binding Value, ElementName=SliderOutlineThickness, StringFormat={}{0:0.0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Calibration & Offset Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="POSITION OFFSET (CALIBRATION)" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Button x:Name="BtnResetOffset" Style="{StaticResource RoundedButtonStyle}" Content="Center (0,0)" Click="BtnResetOffset_Click"
                                        HorizontalAlignment="Right" Padding="8,3" FontSize="11" Background="#252A34" Foreground="#00F0FF" BorderThickness="0"/>
                            </Grid>
                            <TextBlock Text="Kalibrasi posisi jika crosshair senjata di game sedikit melenceng dari titik tengah layar."
                                       FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                            <!-- Offset X -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Offset X (Horizontal px)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderOffsetX" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblOffsetX" Grid.Column="2" Text="{Binding Value, ElementName=SliderOffsetX, StringFormat={}{0:0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>

                            <!-- Offset Y -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Offset Y (Vertical px)" Style="{StaticResource SettingLabel}"/>
                                <Slider x:Name="SliderOffsetY" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" />
                                <TextBlock x:Name="LblOffsetY" Grid.Column="2" Text="{Binding Value, ElementName=SliderOffsetY, StringFormat={}{0:0}}" Style="{StaticResource ValueLabel}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Global Hotkeys Info Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="GLOBAL HOTKEYS (IN-GAME)" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#12151B" CornerRadius="6" Padding="10,8" Margin="0,0,6,0" BorderBrush="#252A34" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="F10" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                                        <TextBlock Text="Toggle Overlay On / Off" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#12151B" CornerRadius="6" Padding="10,8" Margin="6,0,0,0" BorderBrush="#252A34" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="F9" FontSize="14" FontWeight="Bold" Foreground="#00F0FF"/>
                                        <TextBlock Text="Show / Hide Settings Menu" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Background="#12151B" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" BorderBrush="#252A34" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Page Up / Page Down" FontSize="13" FontWeight="Bold" Foreground="#FFE600" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Cycle Crosshair Styles" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status & Action Bar -->
        <Border Grid.Row="2" Background="#14171D" BorderBrush="#252A34" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnResetAll" Style="{StaticResource RoundedButtonStyle}" Content="Reset to Defaults" Click="BtnResetAll_Click"
                        Padding="12,8" FontSize="12" Background="#20242D" Foreground="#8B949E" BorderBrush="#353D4D" BorderThickness="1"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnToggleVisibility" Style="{StaticResource RoundedButtonStyle}" Content="Toggle Overlay (F10)" Click="BtnToggleVisibility_Click"
                            Padding="14,8" FontSize="12" FontWeight="SemiBold" Background="#20242D" Foreground="#00FF66" BorderBrush="#00FF66" BorderThickness="1" Margin="0,0,10,0"/>
                    <Button x:Name="BtnMinimizeGame" Style="{StaticResource RoundedButtonStyle}" Content="Play Game (Hide Settings)" Click="BtnHideToTray_Click"
                            Padding="16,8" FontSize="12" FontWeight="Bold" Background="#00FF66" Foreground="#0F1115" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
