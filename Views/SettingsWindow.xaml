<Window x:Class="CrosshairOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CrosshairOverlay.Controls"
        xmlns:models="clr-namespace:CrosshairOverlay.Models"
        Title="Crosshair Overlay"
        Height="660" Width="850"
        MinHeight="620" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#121316"
        Foreground="#EDEDED"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="6"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Refined Esports Dark Palette -->
        <SolidColorBrush x:Key="BgMain" Color="#121316" />
        <SolidColorBrush x:Key="PanelBg" Color="#18191E" />
        <SolidColorBrush x:Key="PanelBorder" Color="#262830" />
        <SolidColorBrush x:Key="PanelInset" Color="#131417" />
        <SolidColorBrush x:Key="DividerColor" Color="#22242A" />

        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentGreenHover" Color="#059669" />
        <SolidColorBrush x:Key="AccentMuted" Color="#132B22" />

        <SolidColorBrush x:Key="TextPrimary" Color="#EDEDED" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />

        <SolidColorBrush x:Key="ControlBg" Color="#202227" />
        <SolidColorBrush x:Key="ControlBorder" Color="#2D3038" />
        <SolidColorBrush x:Key="ControlHover" Color="#2B2E37" />

        <!-- Flat Slider Style (Ultra-Lightweight, No GPU Blur) -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ellipse" Fill="#EDEDED" Width="14" Height="14" Cursor="Hand"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ellipse" Property="Fill" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ellipse" Property="Fill" Value="#34D399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#24262E"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Section Header Style -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Setting Row Label Style -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#C2C7D0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Numeric Value Label Style (Anti-Clipping) -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- Tactile Step Button (+ / -) -->
        <Style x:Key="SmallStepButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#202227"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3"
                                BorderBrush="#2A2C34" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2B2E37"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3D414D"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Tab Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2026"/>
                                <Setter Property="Foreground" Value="#EDEDED"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22252D"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Rounded Button -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Palette Button -->
        <Style x:Key="ColorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#2B2D35" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4"
                        Background="#1E2026" BorderBrush="#2D3038" BorderThickness="1"/>
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="#7E8494" Data="M 0 0 L 3.5 3.5 L 7 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#4B5263"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#EDEDED"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#10B981"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#10B981"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="#16171B" CornerRadius="3" Margin="2,1" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#22252E"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1C2622"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,2,24,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="200">
                                    <Border x:Name="DropDownBorder"
                                            Background="#16171B"
                                            BorderBrush="#2D3038"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2,3" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="42" />
            <!-- Main Content Viewport (Fixed, Zero Scrollbars) -->
            <RowDefinition Height="*" />
            <!-- Footer Bar -->
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="#141519" BorderBrush="#22242A" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="4" Background="#10B981" Margin="0,0,8,0">
                        <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#0E1013"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <TextBlock Text="CROSSHAIR" FontWeight="Bold" FontSize="12.5" Foreground="#EDEDED" VerticalAlignment="Center"/>
                    <TextBlock Text="OVERLAY" FontWeight="Normal" FontSize="12.5" Foreground="#7E8494" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    
                    <!-- Clean Minimal Status Indicator -->
                    <Border Background="#132B22" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtStatus" Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center Segmented Navigation -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#1A1B20" BorderBrush="#26282E" BorderThickness="1" CornerRadius="5" Padding="2"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabSettings" Content="Settings" IsChecked="True"
                                     Checked="NavTab_Checked" Style="{StaticResource NavTabButtonStyle}"/>
                        <RadioButton x:Name="TabAbout" Content="About &amp; Feedback"
                                     Checked="NavTab_Checked" Style="{StaticResource NavTabButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Window Chrome Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="#7E8494" FontSize="12" Cursor="Hand" ToolTip="Minimize">
                        <TextBlock Text="—" Margin="0,-2,0,0"/>
                    </Button>
                    <Button x:Name="BtnHideToTray" Click="BtnHideToTray_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="#7E8494" FontSize="9" Cursor="Hand" ToolTip="Hide to background (Keep Crosshair Active)">
                        <TextBlock Text="▼" Margin="0,1,0,0"/>
                    </Button>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Width="32" Height="28" Background="Transparent" BorderThickness="0"
                            Foreground="#7E8494" FontSize="12" Cursor="Hand" ToolTip="Close Application">
                        <TextBlock Text="✕"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VIEW 1: SETTINGS VIEW (2-Panel Architecture, Fit Without Scrollbar) -->
        <Grid x:Name="SettingsView" Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Preview, Shape Selector, Color Accent -->
            <Border Grid.Column="0" Background="#18191E" BorderBrush="#262830" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Live Preview Viewport -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="RETICLE PREVIEW" Style="{StaticResource SectionHeading}"/>
                        <Border Height="165" CornerRadius="5" Background="#121316" BorderBrush="#23252B" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <!-- Minimal Subtle Hair-Cross Guide -->
                                <Path Stroke="#1D1F25" StrokeThickness="1">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,82.5" EndPoint="290,82.5" />
                                            <LineGeometry StartPoint="145,0" EndPoint="145,165" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <controls:CrosshairRenderer x:Name="PreviewRenderer" IsPreview="True" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 2. Style Selector -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="RETICLE SHAPE" Style="{StaticResource SectionHeading}"/>
                        <ComboBox x:Name="CmbStyle" SelectionChanged="CmbStyle_SelectionChanged" Height="30">
                            <ComboBoxItem Content="✚  Classic Cross (+)" />
                            <ComboBoxItem Content="•   Center Dot (•)" />
                            <ComboBoxItem Content="✛  Cross + Dot (+•)" IsSelected="True" />
                            <ComboBoxItem Content="⊥  T-Shape (⊥)" />
                            <ComboBoxItem Content="◯  Circle (O)" />
                            <ComboBoxItem Content="⦿  Circle + Dot (⊙)" />
                            <ComboBoxItem Content="▲  Chevron (^)" />
                            <ComboBoxItem Content="▢  Box (□)" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 3. Color & Palette -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="COLOR &amp; ACCENT" Style="{StaticResource SectionHeading}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#10B981" Click="PresetColor_Click" Tag="#10B981" ToolTip="Emerald Green"/>
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#00FF66" Click="PresetColor_Click" Tag="#00FF66" ToolTip="Neon Green"/>
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#00F0FF" Click="PresetColor_Click" Tag="#00F0FF" ToolTip="Cyan"/>
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#FF3344" Click="PresetColor_Click" Tag="#FF3344" ToolTip="Crimson Red"/>
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#FFE600" Click="PresetColor_Click" Tag="#FFE600" ToolTip="Yellow"/>
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#FFFFFF" Click="PresetColor_Click" Tag="#FFFFFF" ToolTip="White"/>
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#BF5AF2" Click="PresetColor_Click" Tag="#BF5AF2" ToolTip="Purple"/>
                            <Button Style="{StaticResource ColorButtonStyle}" Background="#FF9500" Click="PresetColor_Click" Tag="#FF9500" ToolTip="Orange"/>
                        </WrapPanel>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HEX:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtColorHex" Grid.Column="1" Height="26" Background="#141519" Foreground="#EDEDED" BorderBrush="#2D3038"
                                     VerticalContentAlignment="Center" Padding="6,0" TextChanged="TxtColorHex_TextChanged" FontSize="11.5"/>
                            <Border x:Name="ColorPreviewSwatch" Grid.Column="2" Width="26" Height="26" CornerRadius="3" Background="#10B981" Margin="6,0,0,0" BorderBrush="#2E313A" BorderThickness="1"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Geometry, Outline, Alignment & Shortcuts -->
            <Border Grid.Column="2" Background="#18191E" BorderBrush="#262830" BorderThickness="1" CornerRadius="6" Padding="16,12">
                <StackPanel VerticalAlignment="Center">

                    <!-- SECTION 1: GEOMETRY -->
                    <TextBlock Text="GEOMETRY &amp; DIMENSIONS" Style="{StaticResource SectionHeading}"/>

                    <!-- Length -->
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Length" Style="{StaticResource SettingLabel}" ToolTip="Arm length or circle radius in pixels"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallStepButton}" Content="-" Click="BtnSizeMinus_Click" Margin="0,0,6,0" ToolTip="Decrease length by 1px"/>
                        <Slider x:Name="SliderSize" Grid.Column="2" Minimum="2" Maximum="50" Value="10" ValueChanged="Slider_ValueChanged" />
                        <Button Grid.Column="3" Style="{StaticResource SmallStepButton}" Content="+" Click="BtnSizePlus_Click" Margin="6,0,6,0" ToolTip="Increase length by 1px"/>
                        <TextBlock x:Name="LblSize" Grid.Column="4" Text="{Binding Value, ElementName=SliderSize, StringFormat={}{0:0}px}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <!-- Thickness -->
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thickness" Style="{StaticResource SettingLabel}" ToolTip="Line stroke thickness in pixels"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallStepButton}" Content="-" Click="BtnThicknessMinus_Click" Margin="0,0,6,0" ToolTip="Decrease thickness by 1px"/>
                        <Slider x:Name="SliderThickness" Grid.Column="2" Minimum="1" Maximum="12" Value="2" ValueChanged="Slider_ValueChanged" />
                        <Button Grid.Column="3" Style="{StaticResource SmallStepButton}" Content="+" Click="BtnThicknessPlus_Click" Margin="6,0,6,0" ToolTip="Increase thickness by 1px"/>
                        <TextBlock x:Name="LblThickness" Grid.Column="4" Text="{Binding Value, ElementName=SliderThickness, StringFormat={}{0:0}px}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <!-- Center Gap -->
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Center Gap" Style="{StaticResource SettingLabel}" ToolTip="Spacing from the center point in pixels"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallStepButton}" Content="-" Click="BtnGapMinus_Click" Margin="0,0,6,0" ToolTip="Decrease gap by 1px"/>
                        <Slider x:Name="SliderGap" Grid.Column="2" Minimum="0" Maximum="30" Value="5" ValueChanged="Slider_ValueChanged" />
                        <Button Grid.Column="3" Style="{StaticResource SmallStepButton}" Content="+" Click="BtnGapPlus_Click" Margin="6,0,6,0" ToolTip="Increase gap by 1px"/>
                        <TextBlock x:Name="LblGap" Grid.Column="4" Text="{Binding Value, ElementName=SliderGap, StringFormat={}{0:0}px}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <!-- Dot Size -->
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Center Dot" Style="{StaticResource SettingLabel}" ToolTip="Diameter of the center dot"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallStepButton}" Content="-" Click="BtnDotSizeMinus_Click" Margin="0,0,6,0" ToolTip="Decrease dot size by 1px"/>
                        <Slider x:Name="SliderDotSize" Grid.Column="2" Minimum="1" Maximum="16" Value="3" ValueChanged="Slider_ValueChanged" />
                        <Button Grid.Column="3" Style="{StaticResource SmallStepButton}" Content="+" Click="BtnDotSizePlus_Click" Margin="6,0,6,0" ToolTip="Increase dot size by 1px"/>
                        <TextBlock x:Name="LblDotSize" Grid.Column="4" Text="{Binding Value, ElementName=SliderDotSize, StringFormat={}{0:0}px}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <!-- Opacity -->
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" Style="{StaticResource SettingLabel}" ToolTip="Reticle alpha transparency"/>
                        <Border Grid.Column="1" Width="22"/>
                        <Slider x:Name="SliderOpacity" Grid.Column="2" Minimum="10" Maximum="100" Value="100" ValueChanged="Slider_ValueChanged" />
                        <Border Grid.Column="3" Width="28"/>
                        <TextBlock x:Name="LblOpacity" Grid.Column="4" Text="{Binding Value, ElementName=SliderOpacity, StringFormat={}{0:0}%}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <!-- DIVIDER -->
                    <Rectangle Height="1" Fill="#23252B" Margin="0,8"/>

                    <!-- SECTION 2: OUTLINE & CONTRAST -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CONTRAST OUTLINE" Style="{StaticResource SectionHeading}" Margin="0"/>
                        <CheckBox x:Name="ChkHasOutline" Grid.Column="1" Content="Enable" Foreground="#C2C7D0" FontSize="11"
                                  IsChecked="True" Checked="ChkHasOutline_Changed" Unchecked="ChkHasOutline_Changed" Cursor="Hand"/>
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Outline Width" Style="{StaticResource SettingLabel}" ToolTip="Dark outer boundary for contrast against bright surfaces"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallStepButton}" Content="-" Click="BtnOutlineMinus_Click" Margin="0,0,6,0" ToolTip="Decrease outline by 0.5px"/>
                        <Slider x:Name="SliderOutlineThickness" Grid.Column="2" Minimum="0.5" Maximum="4" Value="1" ValueChanged="Slider_ValueChanged" />
                        <Button Grid.Column="3" Style="{StaticResource SmallStepButton}" Content="+" Click="BtnOutlinePlus_Click" Margin="6,0,6,0" ToolTip="Increase outline by 0.5px"/>
                        <TextBlock x:Name="LblOutlineThickness" Grid.Column="4" Text="{Binding Value, ElementName=SliderOutlineThickness, StringFormat={}{0:0.0}px}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <!-- DIVIDER -->
                    <Rectangle Height="1" Fill="#23252B" Margin="0,8"/>

                    <!-- SECTION 3: CALIBRATION / OFFSET -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ALIGNMENT / OFFSET" Style="{StaticResource SectionHeading}" Margin="0"/>
                        <Button x:Name="BtnResetOffset" Grid.Column="1" Style="{StaticResource RoundedButtonStyle}" Content="Center (0,0)" Click="BtnResetOffset_Click"
                                Padding="8,2" FontSize="10.5" Background="#202227" Foreground="#10B981" BorderBrush="#2D3038" BorderThickness="1" ToolTip="Reset offset back to exact screen center"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Offset X" Style="{StaticResource SettingLabel}" ToolTip="Nudge horizontally"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallStepButton}" Content="-" Click="BtnOffsetXMinus_Click" Margin="0,0,6,0"/>
                        <Slider x:Name="SliderOffsetX" Grid.Column="2" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" />
                        <Button Grid.Column="3" Style="{StaticResource SmallStepButton}" Content="+" Click="BtnOffsetXPlus_Click" Margin="6,0,6,0"/>
                        <TextBlock x:Name="LblOffsetX" Grid.Column="4" Text="{Binding Value, ElementName=SliderOffsetX, StringFormat={}{0:0}px}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Offset Y" Style="{StaticResource SettingLabel}" ToolTip="Nudge vertically"/>
                        <Button Grid.Column="1" Style="{StaticResource SmallStepButton}" Content="-" Click="BtnOffsetYMinus_Click" Margin="0,0,6,0"/>
                        <Slider x:Name="SliderOffsetY" Grid.Column="2" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_ValueChanged" />
                        <Button Grid.Column="3" Style="{StaticResource SmallStepButton}" Content="+" Click="BtnOffsetYPlus_Click" Margin="6,0,6,0"/>
                        <TextBlock x:Name="LblOffsetY" Grid.Column="4" Text="{Binding Value, ElementName=SliderOffsetY, StringFormat={}{0:0}px}" Style="{StaticResource ValueLabel}"/>
                    </Grid>

                    <!-- DIVIDER -->
                    <Rectangle Height="1" Fill="#23252B" Margin="0,8"/>

                    <!-- SECTION 4: IN-GAME SHORTCUT STRIP -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#141519" CornerRadius="4" Padding="8,5" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="F10" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="Toggle" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#141519" CornerRadius="4" Padding="8,5" Margin="3,0,3,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="F9" FontSize="11" FontWeight="Bold" Foreground="#EDEDED" Margin="0,0,6,0"/>
                                <TextBlock Text="Menu" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#141519" CornerRadius="4" Padding="8,5" Margin="3,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="PgUp/Dn" FontSize="11" FontWeight="Bold" Foreground="#EDEDED" Margin="0,0,6,0"/>
                                <TextBlock Text="Cycle" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <!-- VIEW 2: ABOUT & CONTACT VIEW (Clean 2-Panel Architecture) -->
        <Grid x:Name="AboutView" Grid.Row="1" Margin="14,12,14,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Contact & Direct Feedback Form -->
            <Border Grid.Column="0" Background="#18191E" BorderBrush="#262830" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Contact Details -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="CONTACT DEVELOPER" Style="{StaticResource SectionHeading}"/>
                        <Border Background="#131417" CornerRadius="4" Padding="8,6" Margin="0,0,0,6" BorderBrush="#23252B" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Developer Email" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="keefastudys@gmail.com" FontSize="11" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource RoundedButtonStyle}" Content="Copy" Click="BtnCopyEmail_Click"
                                        Padding="7,3" FontSize="10.5" Background="#1E2026" Foreground="#10B981" BorderBrush="#2E3038" BorderThickness="1" ToolTip="Copy email address"/>
                            </Grid>
                        </Border>

                        <Border Background="#131417" CornerRadius="4" Padding="8,6" Margin="0,0,0,2" BorderBrush="#23252B" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="GitHub Profile" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="github.com/keefalegends" FontSize="11" FontWeight="SemiBold" Foreground="#EDEDED"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource RoundedButtonStyle}" Content="Open" Click="BtnOpenProfile_Click"
                                        Padding="7,3" FontSize="10.5" Background="#1E2026" Foreground="#EDEDED" BorderBrush="#2E3038" BorderThickness="1" ToolTip="Visit GitHub Profile"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Row="1" Height="1" Fill="#23252B" Margin="0,10"/>

                    <!-- Feedback Form -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="DIRECT FEEDBACK &amp; REQUEST" Style="{StaticResource SectionHeading}"/>
                        <ComboBox x:Name="CmbFeedbackType" Height="28" Margin="0,0,0,8">
                            <ComboBoxItem Content="💡  Feature Request" IsSelected="True" />
                            <ComboBoxItem Content="🎯  New Reticle Shape" />
                            <ComboBoxItem Content="🐛  Bug Report" />
                            <ComboBoxItem Content="💬  General Feedback" />
                        </ComboBox>

                        <TextBox x:Name="TxtFeedback" Height="90" Background="#131417" Foreground="#EDEDED" BorderBrush="#282B33"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Padding="8,6" FontSize="11" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                        <Button Style="{StaticResource RoundedButtonStyle}" Click="BtnSendGithubIssue_Click"
                                Background="#10B981" Foreground="#0E1013" BorderThickness="0" Padding="10,7" Margin="0,0,0,6">
                            <TextBlock Text="🚀  Submit GitHub Issue" FontWeight="Bold" FontSize="11"/>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource RoundedButtonStyle}" Click="BtnSendEmail_Click"
                                    Background="#1E2026" Foreground="#EDEDED" BorderBrush="#2E3038" BorderThickness="1" Padding="6,5" ToolTip="Open in Gmail Web Compose">
                                <TextBlock Text="✉️  Via Gmail" FontSize="10.5" FontWeight="SemiBold"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Click="BtnCopyFeedback_Click"
                                    Background="#1E2026" Foreground="#9CA3AF" BorderBrush="#2E3038" BorderThickness="1" Padding="6,5" ToolTip="Copy feedback to clipboard">
                                <TextBlock Text="📋  Copy Text" FontSize="10.5" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Creator Profile, Specs & Architecture -->
            <Border Grid.Column="2" Background="#18191E" BorderBrush="#262830" BorderThickness="1" CornerRadius="6" Padding="18,14">
                <StackPanel VerticalAlignment="Center">
                    <!-- Profile Card -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#132B22"
                                BorderBrush="#10B981" BorderThickness="1.5" Margin="0,0,14,0">
                            <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KeefaLegends" FontSize="16" FontWeight="Bold" Foreground="#EDEDED"/>
                                <Border Background="#132B22" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="AUTHOR" FontSize="9" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Software Engineer • Creator of Crosshair Overlay" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Click="BtnOpenGithub_Click"
                                Background="#1E2026" BorderBrush="#2E3038" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="★  GitHub" FontSize="11" FontWeight="SemiBold" Foreground="#EDEDED"/>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="#23252B" Margin="0,0,0,12"/>

                    <!-- Highlights Grid (2x2) -->
                    <TextBlock Text="ENGINEERING ARCHITECTURE" Style="{StaticResource SectionHeading}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="#131417" CornerRadius="4" Padding="10" Margin="0,0,4,8" BorderBrush="#23252B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🛡️  Anti-Cheat Compliant" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="Pure top-level transparent DWM layer. No DLL injection or memory hook."
                                           FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#131417" CornerRadius="4" Padding="10" Margin="4,0,0,8" BorderBrush="#23252B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🖱️  Zero Input Latency" FontSize="11.5" FontWeight="Bold" Foreground="#EDEDED"/>
                                <TextBlock Text="Native Win32 WS_EX_TRANSPARENT pass-through with no mouse click lag."
                                           FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#131417" CornerRadius="4" Padding="10" Margin="0,0,4,0" BorderBrush="#23252B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡  DirectX Accelerated" FontSize="11.5" FontWeight="Bold" Foreground="#EDEDED"/>
                                <TextBlock Text="Vector reticle renderer with sub-1% CPU and GPU frame overhead."
                                           FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#131417" CornerRadius="4" Padding="10" Margin="4,0,0,0" BorderBrush="#23252B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🎯  Pixel-Perfect Calibration" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="8 vector shapes with discrete single-pixel nudge offsets."
                                           FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="#23252B" Margin="0,6,0,10"/>

                    <TextBlock Text="Built with C# .NET WPF • Open Source on GitHub under MIT License"
                               HorizontalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION FOOTER -->
        <Border Grid.Row="2" Background="#141519" BorderBrush="#22242A" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Subtle Reset Button -->
                <Button x:Name="BtnResetAll" Style="{StaticResource RoundedButtonStyle}" Content="↺  Reset Defaults" Click="BtnResetAll_Click"
                        Padding="12,6" FontSize="11" Background="#1A1B20" Foreground="#9CA3AF" BorderBrush="#2B2D35" BorderThickness="1"
                        ToolTip="Reset all geometry, colors, and offset back to factory defaults"/>

                <!-- Right: Action Button Group -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnToggleVisibility" Style="{StaticResource RoundedButtonStyle}" Content="Toggle Overlay (F10)" Click="BtnToggleVisibility_Click"
                            Padding="12,6" FontSize="11" FontWeight="SemiBold" Background="#1E2026" Foreground="#EDEDED" BorderBrush="#2E3038" BorderThickness="1" Margin="0,0,8,0"
                            ToolTip="Show or hide the in-game crosshair (F10)"/>
                    <Button x:Name="BtnMinimizeGame" Style="{StaticResource RoundedButtonStyle}" Content="Play Game (F9)" Click="BtnHideToTray_Click"
                            Padding="16,6" FontSize="11" FontWeight="Bold" Background="#10B981" Foreground="#0E1013" BorderThickness="0"
                            ToolTip="Hide this window and start playing (press F9 anytime to bring back settings)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
